# Copia este archivo como .env y completa los valores.
# Solo se usa para ejecutar scripts/seed.js contra el proyecto REAL de Firebase.
# Con el emulador (npm run seed:emulador) no se necesita nada de esto.

# Ruta local al JSON de la cuenta de servicio (Consola Firebase > Configuración > Cuentas de servicio).
# El archivo NUNCA se sube al repositorio (está en .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=./credenciales/serviceAccountKey.json

# ID del proyecto Firebase real
FIREBASE_PROJECT_ID=tu-project-id
